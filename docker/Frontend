FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS builder
    
COPY . .

RUN pnpm install --frozen-lockfile --ignore-scripts --shamefully-hoist

ARG VITE_API_URL
ARG VITE_FOOTER_LABEL
ARG VITE_INTERNAL_EXPOSE

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_FOOTER_LABEL=$VITE_FOOTER_LABEL
ENV VITE_INTERNAL_EXPOSE=${VITE_INTERNAL_EXPOSE}

RUN pnpm --filter @gis/shared build
RUN pnpm --filter @gis/frontend build

FROM nginx:stable-alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]