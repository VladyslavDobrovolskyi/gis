FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

FROM base AS builder
COPY . .

RUN pnpm install --frozen-lockfile --ignore-scripts --shamefully-hoist
RUN pnpm --filter @gis/shared build
RUN pnpm --filter @gis/backend build

RUN rm -rf node_modules && pnpm install --prod --frozen-lockfile --shamefully-hoist --ignore-scripts

FROM node:24-alpine AS runner
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/backend/dist ./apps/backend/dist
COPY --from=builder /app/apps/backend/package.json ./apps/backend/package.json
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "apps/backend/dist/src/server.js"]