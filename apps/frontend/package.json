{
  "name": "@gis/frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm run clean && vite build",
    "start": "vite preview",
    "lint": "eslint --ext .ts,.vue src",
    "lint:fix": "eslint --ext .ts,.vue src --fix",
    "prettier:check": "pnpm prettier --check **/*.{ts,js,json,html,css,yaml,yml}",
    "prettier:write": "pnpm prettier --write **/*.{ts,js,json,html,css,yaml,yml} --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@gis/backend": "workspace:*",
    "@gis/shared": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/vue-query": "^5.92.5",
    "@trpc/client": "^11.8.1",
    "@types/geojson": "^7946.0.16",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geojson": "^0.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.24",
    "vue-leaflet": "^0.1.0"
  },
  "devDependencies": {
    "@trpc/server": "^11.8.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
